PORT=8080
ENV=development
# Privileged connection for database migrations (DDL/Admin)
MIGRATION_DATABASE_URL=postgres://eghissab:change-me-strong-password@localhost:5432/eghissab_v1_dev?sslmode=disable
# Restricted connection for application runtime (DML only, NOBYPASSRLS)
DATABASE_URL=postgres://eghissab_app:change-me-app-password@localhost:5432/eghissab_v1_dev?sslmode=disable

# Optional Connection Pool Tuning
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m

# Authentication: generate a unique signing key with openssl rand -base64 32.
AUTH_SIGNING_KEY=
AUTH_ISSUER=eghissab-api
AUTH_AUDIENCE=eghissab-clients
# HTTPS frontend page that POSTs the token to /auth/verify-email.
AUTH_VERIFICATION_URL=https://your-app.example/verify-email
# Optional, comma-separated CIDRs of ONLY your reverse proxy hops.
# Blank means ignore forwarded headers; rate limits then use the direct peer IP.
AUTH_TRUSTED_PROXY_CIDRS=

# Global API Rate Limiting (Token Bucket per client IP)
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=30

SMTP_ADDR=smtp.your-provider.example:587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.example
